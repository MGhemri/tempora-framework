{
  "name": "tempora-desktop-chromium-fallback",
  "productName": "TEMPORA Desktop",
  "version": "0.1.1-beta.2",
  "private": true,
  "description": "TEMPORA Desktop — local scientific research client",
  "main": "main.cjs",
  "license": "MIT",
  "scripts": {
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.tempora.framework.desktop.chromium",
    "productName": "TEMPORA Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "visualization-service.cjs",
      "build/icon-white-256.png",
      {
        "from": "../dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "../src-tauri/resources/engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../examples",
        "to": "examples",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "TEMPORA-Desktop-${version}-${arch}-SETUP.exe",
      "icon": "build/icon-white-256.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "afterPack": "./after-pack.cjs"
  }
}
