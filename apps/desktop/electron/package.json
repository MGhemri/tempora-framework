{
  "name": "tempora-desktop-chromium-fallback",
  "productName": "TEMPORA Desktop",
  "version": "0.1.2-beta.3",
  "private": true,
  "description": "TEMPORA Desktop — official offline Chromium/Electron scientific research client",
  "main": "main.cjs",
  "license": "MIT",
  "scripts": {
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.tempora.framework.desktop.chromium",
    "productName": "TEMPORA Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preview-core.cjs",
      "assistant-session.cjs",
      "preload.cjs",
      "visualization-service.cjs",
      "build/icon-white-256.png",
      {
        "from": "../dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      },
      "recovery-assessment.cjs",
      "transaction-store.cjs",
      "review-persistence-gate.cjs",
      "review-persistence-adapter.cjs",
      "review-persistence-coordinator.cjs"
    ],
    "extraResources": [
      {
        "from": "../src-tauri/resources/engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../examples",
        "to": "examples",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../../src/framework/assist-inspection.js",
        "to": "assistant/framework/assist-inspection.js"
      },
      {
        "from": "../../../src/assist-io",
        "to": "assistant/assist-io",
        "filter": [
          "xlsx-inventory.js",
          "xlsx-cells.js"
        ]
      },
      {
        "from": "../../../src/framework/assist-mapping.js",
        "to": "assistant/framework/assist-mapping.js"
      },
      {
        "from": "../../../profiles/synthetic-history/profile.json",
        "to": "assistant/profiles/synthetic-history/profile.json"
      },
      {
        "from": "../../../src/framework/assist-preview.js",
        "to": "assistant/framework/assist-preview.js"
      },
      {
        "from": "../../../src/framework/assist-normalization.js",
        "to": "assistant/framework/assist-normalization.js"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "TEMPORA-Desktop-${version}-${arch}-SETUP.exe",
      "icon": "build/icon-white-256.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "afterPack": "./after-pack.cjs"
  }
}
