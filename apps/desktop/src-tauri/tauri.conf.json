{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TEMPORA Desktop",
  "version": "0.1.0",
  "identifier": "org.tempora.framework.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TEMPORA — Research Workspace",
        "width": 1330,
        "height": 830,
        "minWidth": 920,
        "minHeight": 610
      }
    ],
    "security": {
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
