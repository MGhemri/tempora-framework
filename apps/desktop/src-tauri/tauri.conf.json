{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TEMPORA Studio",
  "version": "0.1.0",
  "identifier": "org.tempora.studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TEMPORA Studio — Scientific Workbench",
        "width": 1320,
        "height": 850,
        "minWidth": 920,
        "minHeight": 600,
        "backgroundColor": "#0b1422"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
