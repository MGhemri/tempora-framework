{
  "name": "@tempora/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:bridge": "node --test tests/engine-bridge.test.mjs",
    "stage:windows-engine": "node scripts/stage-windows-engine.mjs",
    "test:windows-engine": "node --test electron/tests/host.test.cjs electron/tests/assistant-session.test.cjs electron/tests/review-integrity.test.cjs electron/tests/transaction-store.test.cjs electron/tests/review-persistence-gate.test.cjs electron/tests/review-persistence-adapter.test.cjs electron/tests/review-persistence-coordinator.test.cjs electron/tests/recovery-assessment.test.cjs electron/tests/native-persistence-workflow.test.cjs electron/tests/assistant-persistence-binding.test.cjs electron/tests/assistant-persistence-authority.test.cjs electron/tests/local-save-access.test.cjs electron/tests/windows-native-destination.test.cjs electron/tests/scientific-native-transport.test.cjs",
    "test:visualization": "node --test tests/visualization/*.test.mjs",
    "test:transaction": "node --test electron/tests/transaction-store.test.cjs",
    "test:persistence-gate": "node --test electron/tests/review-persistence-gate.test.cjs",
    "test:persistence-adapter": "node --test electron/tests/review-persistence-adapter.test.cjs",
    "test:persistence-coordinator": "node --test electron/tests/review-persistence-coordinator.test.cjs",
    "test:recovery": "node --test electron/tests/recovery-assessment.test.cjs",
    "test:native-persistence": "node --test electron/tests/native-persistence-workflow.test.cjs",
    "test:persistence-binding": "node --test electron/tests/assistant-persistence-binding.test.cjs",
    "test:persistence-authority": "node --test electron/tests/assistant-persistence-authority.test.cjs",
    "test:local-save-gate": "node --test electron/tests/local-save-access.test.cjs",
    "test:native-guard": "node --test electron/tests/windows-native-destination.test.cjs",
    "test:scientific-native-transport": "node --test electron/tests/scientific-native-transport.test.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "tempora-framework": "3.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0"
  }
}
