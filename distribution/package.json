{
  "name": "tempora-framework",
  "version": "3.0.0",
  "private": false,
  "description": "Open-source, profile-driven framework for reproducible historical corpora",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tempora": "src/cli/tempora.js"
  },
  "main": "./src/sdk/index.js",
  "types": "./src/sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/sdk/index.d.ts",
      "default": "./src/sdk/index.js"
    },
    "./schemas/profile": "./schemas/tempora.profile.schema.json",
    "./schemas/mapping": "./schemas/tempora.ingestion-mapping.schema.json",
    "./schemas/v3/*": "./schemas/tempora/v3/*.schema.json"
  },
  "files": [
    "src/framework",
    "src/sdk",
    "src/cli",
    "schemas",
    "scripts"
  ],
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MGhemri/tempora-framework.git"
  },
  "homepage": "https://mghemri.github.io/tempora-framework/",
  "bugs": {
    "url": "https://github.com/MGhemri/tempora-framework/issues"
  },
  "keywords": [
    "digital-humanities",
    "history",
    "historical-data",
    "research",
    "provenance",
    "json-schema",
    "corpus",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
