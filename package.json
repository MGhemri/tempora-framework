{
  "name": "tempora-framework",
  "version": "1.0.0",
  "private": true,
  "description": "TEMPORA Framework pour structurer, valider et analyser des corpus historiques par profil",
  "scripts": {
    "test": "npm run test:api && npm run test:data",
    "test:framework": "npm run test:core",
    "test:core": "node --test tests/architecture/framework-isolation.test.js",
    "test:api": "node --test tests/*.test.js",
    "test:blind": "node tests/blind-test.js",
    "test:data": "node tests/run-validation.js",
    "build:data": "node scripts/sync-dataset.js",
    "migrate:legacy": "node scripts/migrate-legacy.js",
    "build:canonical": "node scripts/build-canonical.js",
    "check:canonical": "node scripts/build-canonical.js --check",
    "test:browser": "playwright test",
    "build:documentation": "node scripts/build-documentation.js",
    "check:publication-files": "node scripts/check-publication-files.js",
    "check:documentation": "npm run check:publication-files && node scripts/build-documentation.js --check && node scripts/build-openapi.js --check",
    "build:openapi": "node scripts/build-openapi.js",
    "release:prepare": "node scripts/create-data-release.js",
    "build:releases": "node scripts/build-releases.js",
    "check:releases": "node scripts/build-releases.js --check",
    "build:entity-search": "node scripts/build-entity-search.js",
    "check:entity-search": "node scripts/build-entity-search.js --check",
    "build:assistance": "node scripts/build-assistance.js",
    "check:assistance": "node scripts/build-assistance.js --check",
    "build:coverage": "node scripts/build-coverage.js",
    "check:coverage": "node scripts/build-coverage.js --check",
    "smoke:api:v2": "node scripts/smoke-api-v2.js",
    "validate:profiles": "node scripts/validate-profiles.js",
    "validate:canonical": "node scripts/validate-canonical.js",
    "review:changes": "node scripts/check-review-changes.js",
    "quality:duplicates": "node scripts/report-duplicates.js",
    "quality:conflicts": "node scripts/report-conflicts.js",
    "quality:benchmark": "node scripts/evaluate-duplicates.js",
    "build": "npm run check:publication-files && npm run validate:profiles && npm run build:canonical && npm run build:documentation && npm run build:openapi && npm run build:releases && npm run build:coverage && npm run build:assistance && npm run build:entity-search",
    "pretest:browser": "npm run build:documentation",
    "migrate:tempora": "node scripts/migrate-tempora.js",
    "ingest:tempora": "node scripts/ingest-tempora.js",
    "quality:tempora": "node scripts/analyze-tempora.js",
    "quality:tempora:reference": "node scripts/evaluate-tempora.js",
    "check:tempora:baseline": "node scripts/check-tempora-baseline.js",
    "publication:tempora": "node scripts/publish-tempora.js",
    "serve:tempora": "node scripts/serve-tempora.js",
    "test:package": "node --test tests/architecture/framework-package.test.js",
    "pack:tempora": "node scripts/pack-tempora.js",
    "test:compat:alnop": "node --test tests/alnop-minimal-compatibility.test.js tests/alnop-ingestion-compatibility.test.js tests/framework-canonical.test.js && npm run check:tempora:baseline",
    "test:e2e:synthetic": "npm run test:core && npm run test:package",
    "benchmark:tempora": "node scripts/benchmark-tempora.js",
    "build:site": "node scripts/build-framework-site.js",
    "check:site": "node scripts/build-framework-site.js --check && node --test tests/framework-site.test.js",
    "test:compat:alnop:minimal": "node --test tests/compatibility/alnop/minimal.test.js",
    "test:compat:alnop:full": "node compatibility/alnop/verify.js"
  },
  "dependencies": {
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "acorn": "8.19.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chart.js": "^4.6.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "markdown-it": "^15.0.3",
    "typescript": "5.9.3"
  }
}
