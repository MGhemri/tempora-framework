{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://alnop.vercel.app/schemas/entity.schema.json",
  "type":"object","additionalProperties":false,
  "required":["id","kind","label","names","source_ids","editorial_status","review_history","created_at","updated_at","relations"],
  "properties":{
    "id":{"type":"string","pattern":"^(PER|ORG|PLC)_[A-Za-z0-9_-]+$","maxLength":128},
    "kind":{"enum":["person","organization","place"]},
    "label":{"type":"object","additionalProperties":false,"required":["fr","ar"],"properties":{"fr":{"type":["string","null"],"minLength":1},"ar":{"type":["string","null"],"minLength":1}}},
    "names":{"type":"array","minItems":1,"uniqueItems":true,"items":{
      "type":"object","additionalProperties":false,"required":["value","language","role","source_ids","valid_from","valid_to"],
      "properties":{
        "value":{"type":"string","minLength":1,"maxLength":500},"language":{"type":"string","pattern":"^[a-z]{2,3}(-[A-Za-z0-9]+)*$"},
        "script":{"type":["string","null"],"pattern":"^[A-Z][a-z]{3}$"},
        "role":{"enum":["preferred","alias","transliteration","historical_name"]},
        "source_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^SRC_[a-f0-9]{24}$"}},
        "valid_from":{"type":["string","null"],"format":"date"},"valid_to":{"type":["string","null"],"format":"date"}
      }}},
    "source_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^SRC_[a-f0-9]{24}$"}},
    "editorial_status":{"enum":["proposed","under_review","published","withdrawn"]},
    "review_history":{"$ref":"https://alnop.vercel.app/schemas/operation.schema.json#/properties/review_history"},
    "created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},
    "geometry":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["type","coordinates"],"properties":{"type":{"const":"Point"},"coordinates":{"type":"array","minItems":2,"maxItems":2,"prefixItems":[{"type":"number","minimum":-180,"maximum":180},{"type":"number","minimum":-90,"maximum":90}],"items":false}}}]},
    "geometry_role":{"enum":["unknown","exact_site","approximate_site","representative_point"]},
    "geometry_source_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "relations":{"type":"array","uniqueItems":true,"items":{
      "type":"object","additionalProperties":false,"required":["type","target_id","source_ids","review_history"],
      "properties":{"type":{"enum":["same_as_candidate","same_as"]},"target_id":{"type":"string","pattern":"^(PER|ORG|PLC)_[A-Za-z0-9_-]+$"},
        "source_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
        "review_history":{"$ref":"https://alnop.vercel.app/schemas/operation.schema.json#/properties/review_history"}}}}
  }
}
