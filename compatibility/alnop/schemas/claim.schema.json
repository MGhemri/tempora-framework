{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alnop.vercel.app/schemas/claim.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subject", "predicate", "value", "status", "editorial_status", "evidence", "contradicts", "review_history", "created_at", "updated_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^CLM_[A-Za-z0-9_-]+$", "maxLength": 128},
    "subject": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 128},
    "predicate": {"type": "string", "minLength": 1, "maxLength": 200},
    "value": {"oneOf": [
      {"type": "number"}, {"type": "boolean"}, {"type": "null"},
      {"type":"object","additionalProperties":false,"required":["type","lower","upper"],"properties":{"type":{"const":"interval"},"lower":{"type":"number"},"upper":{"type":"number"}}},
      {"type": "object", "additionalProperties": false, "required": ["fr", "ar"],
        "properties": {"fr": {"type": ["string", "null"], "minLength": 1, "maxLength": 10000}, "ar": {"type": ["string", "null"], "minLength": 1, "maxLength": 10000}}}
    ]},
    "unit": {"type": "string", "minLength": 1, "maxLength": 100},
    "context":{"type":"object","additionalProperties":false,"required":["scope","population","time_scope","valid_from","valid_to"],"properties":{
      "scope":{"type":"string","minLength":1,"maxLength":500},"population":{"type":"string","minLength":1,"maxLength":500},
      "time_scope":{"enum":["entire_event","specific_period","unknown"]},"valid_from":{"type":["string","null"],"format":"date"},"valid_to":{"type":["string","null"],"format":"date"}}},
    "status": {"enum": ["supported", "contested", "unverified", "withdrawn"]},
    "editorial_status": {"enum": ["proposed", "under_review", "published", "withdrawn"]},
    "evidence": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {
      "type": "object", "additionalProperties": false, "required": ["source_id", "locator"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^SRC_[a-f0-9]{24}$"},
        "locator": {"type": "string", "minLength": 1, "maxLength": 2000},
        "quotation": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }},
    "contradicts": {"type": "array", "uniqueItems": true, "maxItems": 100, "items": {"type": "string", "pattern": "^CLM_[A-Za-z0-9_-]+$"}},
    "review_history": {"$ref": "https://alnop.vercel.app/schemas/operation.schema.json#/properties/review_history"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
