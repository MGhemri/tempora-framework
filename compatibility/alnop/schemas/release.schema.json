{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["id","published_at","source_commit","schema_version","total","canonical_sha256","snapshot_manifest_sha256","summary","changes","review_scope","corpus_is_incomplete","license_notice","archive_sha256","files"],
  "properties":{
    "id":{"type":"string","pattern":"^data-[0-9]{4}\\.(0[1-9]|1[0-2])\\.[1-9][0-9]*$"},
    "published_at":{"type":"string","format":"date-time","pattern":"Z$"},
    "source_commit":{"type":"string","pattern":"^[a-f0-9]{40}$"},"schema_version":{"const":"2.0.0"},
    "total":{"type":"integer","minimum":0},"canonical_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "snapshot_manifest_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "summary":{"type":"string","minLength":1,"maxLength":2000},
    "changes":{"type":"array","minItems":1,"items":{"type":"string","minLength":1,"maxLength":2000}},
    "review_scope":{"const":"technical_publication_of_existing_corpus"},"corpus_is_incomplete":{"const":true},
    "license_notice":{"type":"string","minLength":1},
    "archive_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "files":{"type":"object","minProperties":1,"propertyNames":{"pattern":"^[A-Za-z0-9_./-]+$"},"additionalProperties":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
  }
}
