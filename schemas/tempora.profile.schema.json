{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:tempora:profile:1.0.0",
  "type":"object","additionalProperties":false,
  "required":["profile_schema_version","version","id","display_name","namespace","framework","default_locale","locales","time","spatial","taxonomies","rules","exports"],
  "properties":{
    "profile_schema_version":{"const":"1.0.0"},
    "version":{"type":"string","pattern":"^[0-9]{1,6}\\.[0-9]{1,6}\\.[0-9]{1,6}$"},
    "id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},
    "namespace":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{0,63}$"},
    "display_name":{"type":"string","minLength":1,"maxLength":200},
    "framework":{"type":"string","pattern":"^>=[0-9]{1,6}\\.[0-9]{1,6}\\.[0-9]{1,6} <[0-9]{1,6}\\.[0-9]{1,6}\\.[0-9]{1,6}$"},
    "default_locale":{"type":"string"},
    "locales":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z]{2,3}(?:-[A-Za-z0-9]+)*$"}},
    "time":{"type":"object","additionalProperties":false,"required":["calendar","coverage"],"properties":{
      "calendar":{"type":"string","minLength":1},
      "coverage":{"type":"object","additionalProperties":false,"required":["earliest","latest"],"properties":{"earliest":{"type":["string","null"],"format":"date"},"latest":{"type":["string","null"],"format":"date"}}}
    }},
    "spatial":{"type":"object","additionalProperties":false,"required":["crs"],"properties":{"crs":{"type":"string","minLength":1}}},
    "taxonomies":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"}},
    "aliases":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["taxonomy","language","value","canonical"],"properties":{"taxonomy":{"type":"string"},"language":{"type":"string"},"value":{"type":"string","minLength":1},"canonical":{"type":"string","minLength":1}}}},
    "parameters":{"type":"object"},
    "rules":{"type":"array","maxItems":128,"items":{"type":"object","additionalProperties":false,"required":["id","type","field","severity"],"properties":{
      "id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}$"},
      "type":{"enum":["required","date_range","vocabulary"]},
      "field":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
      "taxonomy":{"type":"string"},"severity":{"enum":["error","warning","info"]},"enabled":{"type":"boolean"}
    }}},
    "exports":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["json","geojson","csv"]}}
  }
}
