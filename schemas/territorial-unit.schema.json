{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["id","names","type","valid_from","valid_to","source_ids","review_status"],
  "properties":{
    "id":{"type":"string","pattern":"^[A-Za-z0-9_-]+$"},
    "names":{"type":"object","additionalProperties":false,"required":["fr","ar"],"properties":{"fr":{"type":"string","minLength":1},"ar":{"type":["string","null"]}}},
    "type":{"enum":["editorial_category","historical_unit"]},
    "valid_from":{"type":["string","null"],"format":"date"},
    "valid_to":{"type":["string","null"],"format":"date"},
    "source_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "review_status":{"enum":["needs_review","reviewed"]},
    "review_history":{"$ref":"https://alnop.vercel.app/schemas/operation.schema.json#/properties/review_history"}
  }
}
