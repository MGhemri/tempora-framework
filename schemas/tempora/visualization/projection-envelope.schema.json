{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tempora:visualization:projection-envelope:1.0.0",
  "title": "TEMPORA Visual Research Workbench — derived projection envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projection_schema_version",
    "algorithm",
    "corpus",
    "source",
    "scope",
    "diagnostics",
    "result",
    "scientific_sha256"
  ],
  "properties": {
    "projection_schema_version": {
      "const": "1.0.0"
    },
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "parameters_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\\\.[0-9]+\\\\.[0-9]+$"
        },
        "parameters_sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_sha256",
        "schema_version",
        "profile_id"
      ],
      "properties": {
        "canonical_sha256": {
          "$ref": "#/$defs/sha"
        },
        "schema_version": {
          "const": "3.0.0"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_version",
        "generated_at",
        "mode"
      ],
      "properties": {
        "engine_version": {
          "const": "3.0.0"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "mode": {
          "enum": [
            "validated",
            "unvalidated-preview"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filters",
        "total_matched",
        "returned",
        "truncated"
      ],
      "properties": {
        "filters": {
          "type": "object"
        },
        "total_matched": {
          "type": "integer",
          "minimum": 0
        },
        "returned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 250
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,79}$"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "result": {
      "type": "array",
      "maxItems": 250
    },
    "scientific_sha256": {
      "$ref": "#/$defs/sha"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
