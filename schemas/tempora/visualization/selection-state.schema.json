{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tempora:visualization:selection-state:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selection_schema_version",
    "corpusKey",
    "viewId",
    "selectedRefs",
    "timeFilter",
    "spatialFilter",
    "predicateFilter",
    "statusFilter",
    "language",
    "evidenceFilter",
    "algorithmContext",
    "partialResult"
  ],
  "properties": {
    "selection_schema_version": {
      "const": "1.0.0"
    },
    "corpusKey": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "viewId": {
      "enum": [
        "geo",
        "graph",
        "chronos",
        "evidence",
        "pattern",
        "observatory"
      ]
    },
    "selectedRefs": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "typed-ref.schema.json"
      }
    },
    "timeFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "earliest",
        "latest"
      ],
      "properties": {
        "mode": {
          "enum": [
            "certain-only",
            "possible-overlap",
            "declared-start"
          ]
        },
        "earliest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "latest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "spatialFilter": {
      "type": "null"
    },
    "predicateFilter": {
      "type": "null"
    },
    "statusFilter": {
      "type": "null"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "evidenceFilter": {
      "type": "null"
    },
    "algorithmContext": {
      "type": "null"
    },
    "partialResult": {
      "type": "boolean"
    }
  }
}
