{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tempora:schema:3.0.0:model",
  "$defs": {
    "Reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "namespace",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "event",
            "source",
            "claim",
            "entity",
            "spatial",
            "relation",
            "review",
            "assessment",
            "release"
          ]
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "maxLength": 200
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "maxLength": 200
        }
      }
    },
    "Text": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "Extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
      },
      "additionalProperties": true
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "locator",
        "quotation"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/Reference"
        },
        "locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "quotation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "transformations"
      ],
      "properties": {
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "transformations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "version",
              "input_sha256",
              "source_path"
            ],
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "input_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "source_path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "TemporalExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "calendar",
        "original",
        "earliest",
        "latest",
        "precision",
        "certainty"
      ],
      "properties": {
        "kind": {
          "enum": [
            "exact",
            "year",
            "month",
            "interval",
            "before",
            "after",
            "unknown"
          ]
        },
        "calendar": {
          "const": "gregorian"
        },
        "original": {
          "type": [
            "string",
            "null"
          ]
        },
        "earliest": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "latest": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "precision": {
          "enum": [
            "day",
            "month",
            "year",
            "range",
            "unknown"
          ]
        },
        "certainty": {
          "enum": [
            "documented",
            "approximate",
            "disputed",
            "unknown"
          ]
        }
      }
    },
    "Geometry": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "Point"
            },
            "coordinates": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                }
              ],
              "items": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "MultiPoint"
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  }
                ],
                "items": false
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "LineString"
            },
            "coordinates": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  }
                ],
                "items": false
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "Polygon"
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    }
                  ],
                  "items": false
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "MultiPolygon"
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 4,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      },
                      {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      }
                    ],
                    "items": false
                  }
                }
              }
            }
          }
        }
      ]
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "namespace",
        "editorial_status",
        "provenance",
        "extensions",
        "kind",
        "title",
        "description",
        "start_date",
        "end_date",
        "event_type",
        "spatial_refs",
        "territory_refs",
        "participant_refs",
        "review_refs"
      ],
      "properties": {
        "schema_version": {
          "const": "3.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "maxLength": 200
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "maxLength": 200
        },
        "editorial_status": {
          "enum": [
            "proposed",
            "under_review",
            "published",
            "withdrawn",
            "unspecified"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "kind": {
          "const": "event"
        },
        "title": {
          "$ref": "#/$defs/Text"
        },
        "description": {
          "$ref": "#/$defs/Text"
        },
        "start_date": {
          "$ref": "#/$defs/TemporalExpression"
        },
        "end_date": {
          "$ref": "#/$defs/TemporalExpression"
        },
        "spatial_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "territory_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "participant_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "review_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "event_type": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "namespace",
        "editorial_status",
        "provenance",
        "extensions",
        "kind",
        "title",
        "url",
        "classification",
        "review_refs"
      ],
      "properties": {
        "schema_version": {
          "const": "3.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "maxLength": 200
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "maxLength": 200
        },
        "editorial_status": {
          "enum": [
            "proposed",
            "under_review",
            "published",
            "withdrawn",
            "unspecified"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "kind": {
          "const": "source"
        },
        "title": {
          "$ref": "#/$defs/Text"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "classification": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        }
      }
    },
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "namespace",
        "editorial_status",
        "provenance",
        "extensions",
        "kind",
        "subject",
        "predicate",
        "value",
        "assertion_status",
        "contradicts",
        "review_refs",
        "unit",
        "context"
      ],
      "properties": {
        "schema_version": {
          "const": "3.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "maxLength": 200
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "maxLength": 200
        },
        "editorial_status": {
          "enum": [
            "proposed",
            "under_review",
            "published",
            "withdrawn",
            "unspecified"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "kind": {
          "const": "claim"
        },
        "subject": {
          "$ref": "#/$defs/Reference"
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "assertion_status": {
          "enum": [
            "supported",
            "contested",
            "unverified",
            "withdrawn"
          ]
        },
        "contradicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "review_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "context": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope",
                "population",
                "time_scope",
                "start_date",
                "end_date"
              ],
              "properties": {
                "scope": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "population": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "time_scope": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "start_date": {
                  "$ref": "#/$defs/TemporalExpression"
                },
                "end_date": {
                  "$ref": "#/$defs/TemporalExpression"
                }
              }
            }
          ]
        }
      }
    },
    "Entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "namespace",
        "editorial_status",
        "provenance",
        "extensions",
        "kind",
        "entity_type",
        "label",
        "names",
        "valid_from",
        "valid_to",
        "spatial_refs",
        "review_refs"
      ],
      "properties": {
        "schema_version": {
          "const": "3.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "maxLength": 200
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "maxLength": 200
        },
        "editorial_status": {
          "enum": [
            "proposed",
            "under_review",
            "published",
            "withdrawn",
            "unspecified"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "kind": {
          "const": "entity"
        },
        "entity_type": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "names": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "language",
              "role",
              "valid_from",
              "valid_to",
              "evidence"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "language": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "valid_from": {
                "$ref": "#/$defs/TemporalExpression"
              },
              "valid_to": {
                "$ref": "#/$defs/TemporalExpression"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Evidence"
                }
              }
            }
          }
        },
        "valid_from": {
          "$ref": "#/$defs/TemporalExpression"
        },
        "valid_to": {
          "$ref": "#/$defs/TemporalExpression"
        },
        "spatial_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "review_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        }
      }
    },
    "SpatialAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "namespace",
        "editorial_status",
        "provenance",
        "extensions",
        "kind",
        "subject",
        "label",
        "geometry",
        "crs",
        "geometry_role",
        "precision_meters",
        "geocoding_method",
        "reference_version",
        "place"
      ],
      "properties": {
        "schema_version": {
          "const": "3.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "maxLength": 200
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "maxLength": 200
        },
        "editorial_status": {
          "enum": [
            "proposed",
            "under_review",
            "published",
            "withdrawn",
            "unspecified"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "kind": {
          "const": "spatial"
        },
        "subject": {
          "$ref": "#/$defs/Reference"
        },
        "label": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "crs": {
          "const": "EPSG:4326"
        },
        "geometry_role": {
          "enum": [
            "unknown",
            "exact_site",
            "approximate_site",
            "approximate_area",
            "representative_point",
            "operation_area",
            "administrative_area"
          ]
        },
        "precision_meters": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "geocoding_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "place": {
          "oneOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "namespace",
        "editorial_status",
        "provenance",
        "extensions",
        "kind",
        "subject",
        "predicate",
        "object",
        "valid_from",
        "valid_to",
        "review_refs"
      ],
      "properties": {
        "schema_version": {
          "const": "3.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "maxLength": 200
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "maxLength": 200
        },
        "editorial_status": {
          "enum": [
            "proposed",
            "under_review",
            "published",
            "withdrawn",
            "unspecified"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "kind": {
          "const": "relation"
        },
        "subject": {
          "$ref": "#/$defs/Reference"
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "$ref": "#/$defs/Reference"
        },
        "valid_from": {
          "$ref": "#/$defs/TemporalExpression"
        },
        "valid_to": {
          "$ref": "#/$defs/TemporalExpression"
        },
        "review_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        }
      }
    },
    "Review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "namespace",
        "editorial_status",
        "provenance",
        "extensions",
        "kind",
        "subject",
        "agent_type",
        "agent",
        "method",
        "decision",
        "reason",
        "reviewed_at",
        "reference",
        "content_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "3.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "maxLength": 200
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "maxLength": 200
        },
        "editorial_status": {
          "enum": [
            "proposed",
            "under_review",
            "published",
            "withdrawn",
            "unspecified"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "kind": {
          "const": "review"
        },
        "subject": {
          "$ref": "#/$defs/Reference"
        },
        "agent_type": {
          "enum": [
            "human",
            "automatic",
            "unspecified"
          ]
        },
        "agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "Assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "namespace",
