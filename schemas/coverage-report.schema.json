{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["calculation_version","scope","corpus_is_incomplete","pending_contributions","summary","groups","methodology"],
  "properties":{
    "calculation_version":{"const":"coverage-v1"},"scope":{"type":"string"},"corpus_is_incomplete":{"const":true},"pending_contributions":{"type":"null"},
    "summary":{"type":"object","$ref":"#/$defs/metrics","unevaluatedProperties":false},
    "groups":{"type":"object","additionalProperties":false,"required":["year","territory","type"],"properties":{"year":{"type":"array","items":{"$ref":"#/$defs/row"}},"territory":{"type":"array","items":{"$ref":"#/$defs/row"}},"type":{"type":"array","items":{"$ref":"#/$defs/row"}}}},
    "methodology":{"type":"object","additionalProperties":false,"required":["year_domain","year_basis","group_totals_are_additive","primary_source_rule","pending_contributions_status"],"properties":{
      "year_domain":{"enum":["inclusive_calendar_years","observed_years_only"]},"year_basis":{"type":"string"},
      "group_totals_are_additive":{"type":"object","additionalProperties":false,"required":["year","territory","type"],"properties":{"year":{"const":true},"territory":{"const":false},"type":{"const":false}}},
      "primary_source_rule":{"type":"string"},"pending_contributions_status":{"const":"not_measured"}}}
  },
  "$defs":{
    "metrics":{"type":"object","required":["total_operations","unique_sources","without_sources","without_identified_primary_source","uncertain_start_dates","uncertain_locations","without_structured_territory","operations_with_contested_claims","without_recorded_review"],"properties":{
      "total_operations":{"type":"integer","minimum":0},"unique_sources":{"type":"integer","minimum":0},"without_sources":{"type":"integer","minimum":0},"without_identified_primary_source":{"type":"integer","minimum":0},"uncertain_start_dates":{"type":"integer","minimum":0},"uncertain_locations":{"type":"integer","minimum":0},"without_structured_territory":{"type":"integer","minimum":0},"operations_with_contested_claims":{"type":"integer","minimum":0},"without_recorded_review":{"type":"integer","minimum":0}}},
    "row":{"type":"object","allOf":[{"$ref":"#/$defs/metrics"}],"required":["key","label","note"],"properties":{"key":{"type":"string"},"label":{"type":"object","additionalProperties":false,"required":["fr","ar"],"properties":{"fr":{"type":["string","null"]},"ar":{"type":["string","null"]}}},"note":{"enum":[null,"no_current_record"]}},"unevaluatedProperties":false}
  }
}
